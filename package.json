{
  "name": "cargogo",
  "version": "1.8.4",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@cargogo/api",
    "dev:mobile": "npm run start --workspace=@cargogo/mobile",
    "build:api": "npm run build --workspace=@cargogo/api",
    "db:migrate": "npm run db:migrate --workspace=@cargogo/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify:modules": "npm run verify:modules --workspace=@cargogo/api",
    "verify:payments": "node scripts/verify-liqpay-signature.mjs",
    "verify:economics": "node scripts/verify-economics.mjs",
    "verify:verification": "node scripts/verify-verification.mjs",
    "verify:verification-upload": "node scripts/verify-verification-upload.mjs",
    "verify:verification-mobile": "node scripts/verify-mobile-verification-upload.mjs",
    "verify:handover-evidence": "node scripts/verify-handover-evidence.mjs",
    "verify:disputes": "node scripts/verify-disputes.mjs",
    "verify:delivery-refusal": "node scripts/verify-delivery-refusal.mjs",
    "verify:handover-sync": "node scripts/verify-handover-sync.mjs",
    "verify:moderator-evidence": "node scripts/verify-moderator-evidence.mjs",
    "verify:handover-limits": "node scripts/verify-handover-limits.mjs",
    "verify:dispute-auth-phone": "node scripts/verify-dispute-auth-phone.mjs",
    "verify:staff-workspace": "node scripts/verify-staff-workspace.mjs",
    "verify:declared-value": "node scripts/verify-declared-value.mjs",
    "verify:live-experience": "node scripts/verify-live-experience.mjs",
    "verify:trip-edit-brand": "node scripts/verify-trip-edit-brand.mjs",
    "verify:route-badger": "node scripts/verify-route-badger.mjs",
    "verify:ui-polish": "node scripts/verify-ui-polish.mjs",
    "verify:carrier-modes": "node scripts/verify-carrier-modes.mjs",
    "verify:professional-ui": "node scripts/verify-professional-ui.mjs",
    "verify:professional-review": "node scripts/verify-professional-review.mjs",
    "verify:matching-current": "node scripts/verify-matching-current.mjs",
    "verify:road-routing": "node scripts/verify-road-routing.mjs",
    "verify:finance-ops": "node scripts/verify-finance-ops.mjs",
    "verify:production-readiness": "node scripts/verify-production-readiness.mjs",
    "release:gate": "node scripts/run-release-gate.mjs",
    "verification:on": "powershell -ExecutionPolicy Bypass -File scripts/enable-verification.ps1",
    "verify:reconsent": "node scripts/verify-reconsent-gate.mjs",
    "economics:v1.7": "powershell -ExecutionPolicy Bypass -File scripts/enable-v1.7-economics.ps1",
    "verify:business-foundation": "node scripts/verify-business-foundation.mjs",
    "verify:runtime-api": "node scripts/verify-runtime-api-override.mjs",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "backup:local": "powershell -ExecutionPolicy Bypass -File scripts/backup-local.ps1",
    "backup:verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-backup.ps1",
    "verify:grant-readiness": "node scripts/verify-grant-readiness.mjs",
    "verify:badger-run": "node scripts/verify-badger-run-reset.mjs",
    "verify:driver-readiness": "node scripts/verify-driver-readiness-ux.mjs",
    "verify:paid-contact-gate": "node scripts/verify-paid-contact-gate.mjs",
    "maps:check:local": "node scripts/verify-maps-key.mjs",
    "maps:check:production": "eas env:exec production \"node scripts/verify-maps-key.mjs\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "expo-dev-client": "~57.0.15",
    "expo": "57.0.16",
    "react": "19.2.3",
    "react-native": "0.86.2"
  }
}

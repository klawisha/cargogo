NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://cargogo:cargogo_dev@127.0.0.1:5433/cargogo
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cargogo-local
S3_ACCESS_KEY=cargogo
S3_SECRET_KEY=change-me-in-local-env
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=info
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Payments: mock | liqpay_sandbox | liqpay_production | disabled
# liqpay_sandbox opens the real LiqPay hosted checkout but does NOT move real money.
PUBLIC_BASE_URL=http://localhost:3000
PAYMENTS_MODE=mock
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_ACTION=hold
ENABLE_REAL_PAYMENTS=false
# Marketplace economics. Values are basis points (100 bps = 1%).
# The client pays the accepted offer amount; provider costs are absorbed inside the marketplace fee.
TARGET_NET_MARGIN_BPS=150
ACQUIRING_FEE_ESTIMATE_BPS=130
PAYOUT_FEE_ESTIMATE_BPS=30
MIN_MARKETPLACE_FEE_MINOR=0
# Sandbox-only simulated actual payout provider fee.
PAYOUT_SANDBOX_ACTUAL_FEE_BPS=30
PAYOUTS_MODE=sandbox
PAYOUT_DATA_SECRET=dev-only-change-me-payout-secret-32-characters-minimum
ENABLE_REAL_PAYOUTS=false
DEAL_CODE_SECRET=dev-only-change-me-please-32-characters-minimum

# Manual verification document pipeline
KYC_MODE=manual
VERIFICATION_ENFORCEMENT=on
VERIFICATION_UPLOAD_MAX_BYTES=10485760
VERIFICATION_UPLOAD_URL_TTL_SECONDS=600
VERIFICATION_REVIEW_URL_TTL_SECONDS=300
VERIFICATION_DOCUMENT_RETENTION_DAYS=30

# Road routing. Create a Mapbox public token; leave empty to keep the safe straight-line fallback.
ROUTING_PROVIDER=auto
MAPBOX_ACCESS_TOKEN=

# Legal production identity (required in NODE_ENV=production)
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_TAX_ID=
LEGAL_OPERATOR_ADDRESS=
LEGAL_EMAIL=
PRIVACY_EMAIL=
LEGAL_DOCS_APPROVED=false

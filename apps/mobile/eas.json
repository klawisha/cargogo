{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_API_OVERRIDE": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_API_OVERRIDE": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_ENABLE_API_OVERRIDE": "0"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production"
    }
  }
}

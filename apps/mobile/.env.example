# Build default. Runtime override is available only when __DEV__ or
# EXPO_PUBLIC_ENABLE_API_OVERRIDE=1 (development/internal EAS profiles).
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
EXPO_PUBLIC_ENABLE_API_OVERRIDE=0

# Native Google Maps Android SDK key. Do not commit the real value.
# Local: copy to apps/mobile/.env.local
# EAS/Google Play: configure the same variable in the EAS build environment.
GOOGLE_MAPS_ANDROID_API_KEY=

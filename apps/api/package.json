    "verify:modules": "tsx src/verify-modules.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/throttler": "6.4.0",
    "dotenv": "17.2.2",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@types/express": "^5.0.6",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5",
    "tsx": "4.20.4",
    "typescript": "5.9.2"
  }
